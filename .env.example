# None of these are needed to run the site or the scrape. Without them, the site works and
# says price alerts aren't available.

# --- Price alerts -------------------------------------------------------------------------
# Signs confirm and manage links. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every link already emailed.
ALERTS_SECRET=

# Where alerts are kept: a Supabase project with supabase/migrations applied, reached with
# its secret key (server only; never expose it to the browser).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Or, for local work and the browser tests, keep alerts in this server's memory instead.
# They're lost on restart.
# ALERTS_STORE=memory

# How alert email is sent: Resend, from an address on a domain verified in Resend.
RESEND_API_KEY=
# e.g. Gear Deals <alerts@geardeals.sheetsolved.com>
ALERTS_FROM=
# Or write each email as a line of JSON to this file instead of sending it.
# ALERTS_OUTBOX=./dev.outbox.jsonl

# --- Morning trigger (Vercel production only) ----------------------------------------------
# Let the Vercel schedule in vercel.json start the daily price run (README, "Morning trigger").
# A long random string; Vercel sends it with each scheduled request.
CRON_SECRET=
# A fine-grained GitHub token for this repository only, with Actions: read and write.
PRICES_DISPATCH_TOKEN=

# --- Site ---------------------------------------------------------------------------------
# The origin the site advertises in metadata, the sitemap and alert emails. Defaults to the
# production domain on Vercel production, the deployment's own URL on previews, and
# http://localhost:3000 locally.
# NEXT_PUBLIC_SITE_URL=
